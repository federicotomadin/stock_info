# Backend server port
PORT=

# PostgreSQL — enables paginated screener, DB sort, incremental sync.
# Local: docker compose up -d postgres
# DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_info
DATABASE_URL=

# Optional: Finnhub API key for reliable company fundamentals
# Create one free at https://finnhub.io/
FINNHUB_API_KEY=

# Financial Modeling Prep — fundamentals tab (/api/fmp/fundamentals) and
# stock prices when Stooq fails and Yahoo returns HTTP 429 (rate limit).
# https://financialmodelingprep.com/developer/docs
#
# IMPORTANT: this key must live on the BACKEND host (Render), not only in GitHub Secrets.
# GitHub Actions only builds the static frontend; it does not run Express.
FMP_API_KEY=

# --- Technical analysis (AI narrative for /api/technical-analysis) ---
# Provider to use: gemini | claude | groq (default: gemini).
# If the chosen provider has no key, the server auto-falls-back to any other key available.
# If NO key is configured, the endpoint still returns indicators (SMA, RSI, supports/resistances)
# with `analysis: null` and an `analysisError` explaining how to enable the AI narrative.
AI_PROVIDER=gemini

# Gemini (free tier, recommended). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude (paid). https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Groq (free tier, OpenAI-compatible API). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Frontend (build estático / GitHub Pages) ---
# URL del backend en producción, sin barra final (ej. https://tu-api.onrender.com).
# En local déjalo vacío: Vite hace proxy de /api al servidor.
# VITE_API_ORIGIN=

# Optional: Render free Postgres expiry date (ISO, e.g. 2026-08-08). Empty hides the banner.
# VITE_DB_EXPIRES_AT=
# En local no hace falta.
# VITE_BASE_PATH=

# --- Interactive Brokers (solo local; nunca habilitar en Render) ---
# Requiere IB Gateway o TWS abierto y logueado en esta máquina. En Configure → Settings →
# API → Settings: destildar "Read-Only API" (si no, IB rechaza las órdenes) y dejar tildado
# "Allow connections from localhost only".
# IBKR_ENABLED=true
# Puerto: 4002 IB Gateway paper · 4001 Gateway real · 7497 TWS paper · 7496 TWS real
# IBKR_PORT=4002
# IBKR_CLIENT_ID=17
# Cuenta a operar (paper empieza con "DU"). Si hay una sola cuenta se detecta sola.
# IBKR_ACCOUNT=
# Las cuentas reales están bloqueadas salvo que pongas esto en true.
# IBKR_ALLOW_LIVE=false
# IBKR_MAX_ORDER_USD=1000
# IBKR_MAX_ORDERS_PER_DAY=3
# IBKR_DEFAULT_STOP_PCT=5

# --- Paper trading agent (solo local, solo cuenta paper DU/DF) ---
# Recorre el screener, manda brackets con stop/take-profit y mueve el stop.
# AGENT_ENABLED=true
# AGENT_INTERVAL_MS=900000
# AGENT_MAX_POSITIONS=5
# AGENT_RISK_PCT=1
# AGENT_AI_VETO=true
# Para un ciclo de prueba fuera de 9:30–16:00 ET usá el botón “Probar ahora”.
# AGENT_ALLOW_OUTSIDE_HOURS=false
